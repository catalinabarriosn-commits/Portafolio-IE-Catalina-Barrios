            <a href="https://editor.p5js.org/tu-usuario/sketches/..." target="_blank">Ver sketch</a>
          </article>

        </div>
      </div>
    </section>

    <!-- ===== SECCIÓN EXTRA 2: Habilidades ===== -->
    <section class="habilidades">
      <h2>Habilidades</h2>
      <div class="lista-habilidades">
        <div class="habilidad">
          <span>p5.js / JavaScript</span>
          <div class="barra"><div class="relleno" style="width: 70%;"></div></div>
        </div>
        <div class="habilidad">
          <span>HTML y CSS</span>
