<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portafolio · IE 2026</title>
  <style>
    /* ==========================================================
       Portafolio · IE 2026 — escala de grises, Georgia regular
       ========================================================== */

    :root {
      --papel: #f2f1ee;          /* fondo tipo papel */
      --tarjeta: #ffffff;
      --tinta: #1b1b1b;          /* casi negro */
      --tinta-suave: #6f6f6f;
      --gris-medio: #8f8f8f;
      --linea: #d8d7d3;          /* bordes finos */
      --sombra: 0 10px 24px rgba(0, 0, 0, 0.08);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: Georgia, "Times New Roman", Times, serif;
      font-weight: 400;                       /* Georgia regular */
      background-color: var(--papel);
      /* grilla de puntos finos, como el fondo del collage */
      background-image: radial-gradient(rgba(0, 0, 0, 0.14) 1px, transparent 1px);
      background-size: 22px 22px;
      color: var(--tinta);
      line-height: 1.7;
    }

    /* ---------- Encabezado ---------- */
    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.2rem 2rem;
      background: rgba(242, 241, 238, 0.9);
      backdrop-filter: blur(6px);
      border-bottom: 1px solid var(--linea);
    }

    .logo {
      font-weight: 400;
      font-size: 1.6rem;
      letter-spacing: 6px;
      text-transform: uppercase;
      color: var(--tinta);
    }

    .anio {
      font-size: 0.95rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      color: var(--tinta-suave);
    }

    .nota {                       /* anotación técnica tipo "0798 048" */
      display: block;
      font-size: 0.65rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--gris-medio);
      text-align: right;
    }

    /* ---------- Contenido ---------- */
    main {
      max-width: 1000px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
    }

    section { margin-bottom: 4.5rem; }

    h2 {
      font-weight: 400;
      font-size: 1.7rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
      position: relative;
      padding-bottom: 0.6rem;
    }

    h2::after {                   /* línea fina bajo los títulos */
      content: "";
      position: absolute;
      left: 0;
      bottom: 0;
      width: 48px;
      height: 2px;
      background: var(--tinta);
    }

    /* ---------- Introducción ---------- */
    .introduccion p {
      max-width: 680px;
      color: var(--tinta-suave);
      font-size: 1.05rem;
    }

    /* ---------- Sobre mí ---------- */
    .contenido-sobre-mi {
      display: flex;
      gap: 2.5rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .foto {
      width: 180px;
      height: 180px;
      object-fit: cover;
      border-radius: 50%;
      border: 1px solid var(--tinta);
      filter: grayscale(1);                 /* foto en B/N, como el collage */
      transition: transform 0.4s ease, filter 0.4s ease;
    }

    .foto:hover {
      transform: scale(1.04);
      filter: grayscale(0.5);
    }

    .contenido-sobre-mi p {
      color: var(--tinta-suave);
      max-width: 560px;
    }

    /* ---------- Tareas: tu boceto (cajas apiladas + llave) ---------- */
    .contenedor-tareas {
      display: flex;
      align-items: stretch;
      gap: 1.2rem;
    }

    .llave {
      display: flex;
      align-items: stretch;
      gap: 0.6rem;
    }

    .llave-texto {
      writing-mode: vertical-rl;
      font-weight: 400;
      letter-spacing: 5px;
      text-transform: uppercase;
      color: var(--tinta);
      font-size: 0.9rem;
      padding: 0.5rem 0;
    }

    .llave-grafica {
      width: 24px;
      border-left: 3px solid var(--tinta);
      border-top: 3px solid var(--tinta);
      border-bottom: 3px solid var(--tinta);
      border-top-left-radius: 40px;
      border-bottom-left-radius: 40px;
    }

    .lista-tareas {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
      flex: 1;
    }

    .tarjeta {
      position: relative;
      background: var(--tarjeta);
      border: 1px solid var(--linea);
      border-radius: 4px;                   /* esquinas casi rectas, look técnico */
      padding: 1.8rem 1.5rem 1.4rem;
      box-shadow: var(--sombra);
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .tarjeta:hover {
      transform: translateY(-4px);
      border-color: var(--tinta);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14);
    }

    .numero {
      position: absolute;
      top: -16px;
      left: 1.2rem;
      background: var(--tinta);
      color: #ffffff;
      font-weight: 400;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
    }

    .tarjeta h3 {
      margin: 1rem 0 0.4rem;
      font-weight: 400;
      font-size: 1.1rem;
      letter-spacing: 1px;
    }

    .tarjeta p {
      color: var(--tinta-suave);
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }

    .tarjeta a {
      display: inline-block;
      color: var(--tinta);
      text-decoration: none;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 0.8rem;
      border-bottom: 1px solid var(--gris-medio);
      padding-bottom: 2px;
      transition: border-color 0.3s ease, letter-spacing 0.3s ease;
    }

    .tarjeta a:hover {
      border-color: var(--tinta);
      letter-spacing: 3px;
    }

    /* ---------- Habilidades ---------- */
    .lista-habilidades {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
    }

    .habilidad {
      background: var(--tarjeta);
      border: 1px solid var(--linea);
      border-radius: 4px;
      padding: 1.3rem;
      box-shadow: var(--sombra);
    }

    .habilidad span {
      display: block;
      margin-bottom: 0.6rem;
      font-weight: 400;
      letter-spacing: 1px;
    }

    .barra {
      height: 10px;
      background: #e3e2de;
      border-radius: 2px;
      overflow: hidden;
    }

    .relleno {
      height: 100%;
      background: var(--tinta);
      animation: crecer 1.2s ease forwards;
    }

    @keyframes crecer { from { width: 0; } }

    /* ---------- Contacto ---------- */
    .contacto form {
      max-width: 520px;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .contacto label {
      font-weight: 400;
      font-size: 0.8rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--tinta-suave);
    }

    .contacto input,
    .contacto textarea {
      width: 100%;
      padding: 0.8rem 1rem;
      background: #ffffff;
      border: 1px solid var(--linea);
      border-radius: 4px;
      color: var(--tinta);
      font-family: Georgia, "Times New Roman", Times, serif;
      font-size: 1rem;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .contacto input:focus,
    .contacto textarea:focus {
      outline: none;
      border-color: var(--tinta);
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
    }

    .contacto button {
      align-self: flex-start;
      padding: 0.8rem 2rem;
      background: var(--tinta);
      color: #ffffff;
      border: none;
      border-radius: 4px;
      font-family: Georgia, "Times New Roman", Times, serif;
      font-weight: 400;
      font-size: 0.95rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      cursor: pointer;
      transition: background 0.3s ease, transform 0.3s ease;
    }

    .contacto button:hover {
      background: #3a3a3a;
      transform: translateY(-2px);
    }

    /* ---------- Footer ---------- */
    .footer {
      text-align: center;
      padding: 2rem 1rem;
      border-top: 1px solid var(--linea);
      color: var(--tinta-suave);
      font-size: 0.9rem;
    }

    .footer .nota { text-align: center; margin-top: 0.3rem; }

    /* ---------- Responsividad ---------- */
    @media (max-width: 768px) {
      .header { flex-direction: column; gap: 0.3rem; padding: 1rem; }
      .nota { text-align: center; }
      .contenido-sobre-mi { flex-direction: column; text-align: center; }
      .llave-grafica { width: 16px; }
      .lista-habilidades { grid-template-columns: 1fr; }
      h2 { font-size: 1.4rem; }
    }

    @media (max-width: 480px) {
      main { padding: 1.5rem 1rem; }
    }
  </style>
</head>
<body>

  <!-- ===== TU IDEA: Portafolio + IE 2026 ===== -->
  <header class="header">
    <h1 class="logo">Portafolio</h1>
    <div>
